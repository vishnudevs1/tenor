# Arc network: "testnet" until contracts are audited
NEXT_PUBLIC_ARC_NETWORK=testnet

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Checkout: USDC on Arc is sent here. Use a wallet you control (on testnet, your own MetaMask address is fine).
TENOR_TREASURY_ADDRESS=

# Risk sweep: protects /api/cron/risk. Schedule it every minute in production:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/cron/risk
CRON_SECRET=

# Optional overrides
# EXTENDED_API_URL=https://api.starknet.extended.exchange/api/v1
# TENOR_DATA_DIR=./.data
